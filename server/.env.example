NODE_ENV=development
PORT=4000
PUBLIC_URL=https://replace-with-your-https-api-host
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AGENT_EMAILS=agent@example.com

META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=choose-a-random-webhook-verification-token
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-with-api-key-secret
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CALLER_ID=+10000000000